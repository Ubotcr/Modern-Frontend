---
// src/layouts/components/CalendarWidget.astro
import { getCalendarEvents } from "@/lib/api/events";
import { sortByStart, formatEventDate, getUpcoming } from "@/lib/utils/calendar";
import type { CalendarEvent } from "@/config/calendar";

// Candidatos: todos ordenados. El cliente filtra a los 3 próximos.
// Resiliente: si el fetch de build falla y no hay snapshot, se pinta el
// estado vacío en vez de tumbar el index.
let candidates: CalendarEvent[] = [];
try {
  candidates = sortByStart(await getCalendarEvents());
} catch (err) {
  console.warn("[CalendarWidget] sin datos:", err);
}
---

<section class="px-4 py-12 md:py-16">
  <div class="container mx-auto max-w-3xl">
    <div class="rounded-2xl border border-border bg-card p-6 md:p-8">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-xl font-bold text-text-light md:text-2xl">
          Fechas importantes
        </h2>
        <a
          href="/calendario"
          class="shrink-0 text-sm font-semibold text-primary hover:underline"
        >
          Ver calendario →
        </a>
      </div>

      <ul class="mt-5 flex flex-col divide-y divide-border" data-calendar-widget>
        {
          getUpcoming(candidates, 3).map((ev) => (
            <li class="flex items-start gap-4 py-3">
              <span class="w-24 shrink-0 text-sm font-semibold text-gray">
                {formatEventDate(ev)}
              </span>
              <span class="flex-1 text-sm text-text-light">{ev.title}</span>
              <span class="flex shrink-0 gap-1">
                {ev.universities.map((u) => (
                  <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">
                    {u}
                  </span>
                ))}
              </span>
            </li>
          ))
        }
      </ul>

      <p
        class:list={[
          "mt-4 text-sm text-gray",
          { hidden: getUpcoming(candidates, 3).length > 0 },
        ]}
        data-widget-empty
      >
        Pronto se publicarán las fechas del próximo ciclo.
      </p>
    </div>
  </div>
</section>

<script>
  import { fetchEventsClient } from "@/lib/api/events-client";
  import { formatEventDate, getUpcoming } from "@/lib/utils/calendar";
  import type { CalendarEvent } from "@/config/calendar";

  const list = document.querySelector<HTMLUListElement>(
    "[data-calendar-widget]",
  );
  const emptyMsg = document.querySelector<HTMLElement>("[data-widget-empty]");

  function renderWidget(candidates: CalendarEvent[]) {
    if (!list) return;
    const upcoming = getUpcoming(candidates, 3);

    list.innerHTML = "";
    for (const ev of upcoming) {
      const li = document.createElement("li");
      li.className = "flex items-start gap-4 py-3";

      const date = document.createElement("span");
      date.className = "w-24 shrink-0 text-sm font-semibold text-gray";
      date.textContent = formatEventDate(ev);

      const title = document.createElement("span");
      title.className = "flex-1 text-sm text-text-light";
      title.textContent = ev.title;

      const unis = document.createElement("span");
      unis.className = "flex shrink-0 gap-1";
      for (const u of ev.universities) {
        const badge = document.createElement("span");
        badge.className =
          "rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary";
        badge.textContent = u;
        unis.appendChild(badge);
      }

      li.append(date, title, unis);
      list.appendChild(li);
    }

    emptyMsg?.classList.toggle("hidden", upcoming.length > 0);
  }

  // El HTML inicial (SSG, build-time) ya se ve sin JS. Solo se re-renderiza
  // si el fetch dinámico trae datos frescos del backend.
  fetchEventsClient().then((fresh) => {
    if (fresh) renderWidget(fresh);
  });
</script>
