---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import OurTeam from "@/partials/OurTeam.astro";
import Icon from "@/components/Icon.astro";
import { getListPage } from "@/lib/contentParser";

const data = await getListPage("about/-index.md");
const { title, description, meta_title, page_header, who_we_are, our_team } =
  data.frontmatter;
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base title={title} meta_title={meta_title} description={description}>
  <PageHeader page_header={page_header} />

  <section class="px-4 py-12 md:py-20">
    <div class="container mx-auto max-w-5xl">
      <div class="grid gap-12 md:grid-cols-2 md:items-center">
        <div>
          <h2 class="mt-3 text-2xl font-bold text-text-light md:text-3xl">
            {who_we_are.title}
          </h2>
          <p class="mt-4 text-text">{who_we_are.subtitle}</p>
        </div>

        <div class="flex flex-col gap-4">
          {
            [
              {
                icon: who_we_are.mission.icon,
                title: who_we_are.mission.title,
                content: who_we_are.mission.content,
              },
              {
                icon: who_we_are.problem.icon,
                title: who_we_are.problem.title,
                content: who_we_are.problem.content,
              },
              {
                icon: who_we_are.solution.icon,
                title: who_we_are.solution.title,
                content: who_we_are.solution.content,
              },
            ].map((item) => (
              <div class="flex items-start gap-4 rounded-xl border border-border bg-card p-4 shadow-sm">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-xl text-primary">
                  <Icon name={item.icon} class="text-[1.25rem]" />
                </span>
                <div>
                  <h3 class="font-semibold text-text-light">{item.title}</h3>
                  <p class="mt-1 text-sm text-text">{item.content}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <OurTeam data={our_team} />

  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-3xl text-left">
      <h2 class="text-2xl font-bold text-text-light">Cómo mantenemos Ubot</h2>
      <p class="mt-4 text-text">
        Ubot no es un sitio abandonado. Cada semana revisamos contenido y
        publicamos mejoras. Mantiene el proyecto Eddie Bermúdez,
        Desarrollador del Frontend & Landing, junto al equipo que ves arriba.
      </p>
      <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 text-sm text-text">
        <li>Guías PAA nuevas y actualizadas en el <a class="text-primary hover:underline" href="/blog">blog</a> — las últimas son de septiembre 2026 sobre razonamiento matemático y verbal.</li>
        <li>Fechas oficiales UCR, UNA y TEC en el <a class="text-primary hover:underline" href="/calendario">calendario de admisión</a>, con fuente oficial siempre a la vista.</li>
        <li>Mejoras de la app en el <a class="text-primary hover:underline" href="/changelog">changelog</a> — v2.9 con exámenes especiales y v2.8 con FlipCards y Ruta de Aprendizaje.</li>
      </ul>
      <p class="mt-4 text-sm text-text">
        ¿Ves un error o quieres un tema? Escríbenos a
        <a class="text-primary hover:underline" href="mailto:contacto@ubotcr.com">contacto@ubotcr.com</a>
        y lo corregimos. Respondemos en 1-2 días hábiles.
      </p>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
