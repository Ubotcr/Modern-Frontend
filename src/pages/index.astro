---
import Base from "@/layouts/Base.astro";
import CalendarWidget from "@/components/CalendarWidget.astro";
import Hero from "@/components/Hero.astro";
import CallToAction from "@/partials/CallToAction.astro";
import SpecialExamHighlight from "@/partials/SpecialExamHighlight.astro";
import DiagnosticExam from "@/partials/DiagnosticExam.astro";
import EssentialFeatures from "@/partials/EssentialFeatures.astro";
import FAQ from "@/partials/FAQ.astro";
import Gallery from "@/partials/Gallery.astro";
import HowItWorks from "@/partials/HowItWorks.astro";
import Pricing from "@/partials/Pricing.astro";
import WhyChooseUs from "@/partials/WhyChooseUs.astro";
import { getListPage } from "@/lib/contentParser";
import config from "@/config/config.json";

const homepage = await getListPage("homepage/-index.md");
const essentialFeatures = await getListPage("sections/essential-features.md");
const whyChooseUs = await getListPage("sections/why-choose-us.md");
const howItWorks = await getListPage("sections/how-it-works.md");
const gallery = await getListPage("sections/gallery.md");
const pricing = await getListPage("sections/pricing.md");
const faq = await getListPage("sections/faq.md");
const callToAction = await getListPage("sections/call-to-action.md");
const diagnosticExam = await getListPage("sections/diagnostic-exam.md");
// Special exam content (swapped into DiagnosticExam component)
const specialExam = {
  frontmatter: {
    enable: true,
    badge: "Nuevo · Examen especial",
    title: "Examen especial: oportunidad limitada",
    description: "Participa en el examen especial gratuito y recibe un reporte personalizado con fortalezas y debilidades.",
    button: {
      enable: true,
      link: "https://chat.ubotcr.com/juegos/examenes/especial",
      label: "Hacer examen"
    }
  }
};
const { banner } = homepage.frontmatter;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": config.site.title,
  "operatingSystem": "Web",
  "applicationCategory": "EducationalApplication",
  "url": config.site.base_url,
  "description": config.metadata.meta_description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.frontmatter.faq_list.map((item: any) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Base
  meta_title="Ubot | Examen Diagnóstico gratis y preparación para admisión UCR, UNA, TEC"
  description="Haz el examen diagnóstico gratis de Ubot y descubre tu nivel para el examen de admisión (PAA) de la UCR, UNA y TEC. Simulacros, IA y práctica diaria para prepararte a tu ritmo."
  keywords="examen diagnóstico, examen diagnóstico admisión, prueba diagnóstica universidad, test diagnóstico PAA, diagnóstico UCR UNA TEC, simulacro examen admisión Costa Rica, preparación PAA gratis"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Hero data={banner} />
  <SpecialExamHighlight data={diagnosticExam} />
  <DiagnosticExam data={specialExam} />
  <EssentialFeatures data={essentialFeatures} />
  <Gallery data={gallery} />
  <WhyChooseUs data={whyChooseUs} />
  <HowItWorks data={howItWorks} />
  <Pricing data={pricing} />
  <FAQ data={faq} />
  <CalendarWidget />
  <CallToAction data={callToAction} />
</Base>
